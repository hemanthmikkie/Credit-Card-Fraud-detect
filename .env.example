# Database Configuration (PostgreSQL with SQLAlchemy)
# Default is configured for local PostgreSQL; will fallback gracefully to SQLite if unreachable
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/credit_card_fraud_db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# Fraud Risk Scoring Thresholds (Configurable)
RISK_THRESHOLD_LOW=30.0
RISK_THRESHOLD_HIGH=70.0
OPTIMAL_DECISION_THRESHOLD=0.35

# Random Seed for Reproducibility
RANDOM_SEED=42

